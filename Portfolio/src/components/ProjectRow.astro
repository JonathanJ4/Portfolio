---
interface Props {
	title: string;
	year: number;
	href: string;
}

const { title, year, href } = Astro.props;
---

<article class="project-row">
	<a class="project-row__link" href={href}>
		<div class="project-row__heading">
			<h3>{title}</h3>
			<span class="project-row__metadata">
				<time datetime={String(year)}>{year}</time>
				<span aria-hidden="true">→</span>
			</span>
		</div>
	</a>
</article>
