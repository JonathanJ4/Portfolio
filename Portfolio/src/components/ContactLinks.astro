---
interface Props {
	bulleted?: boolean;
}

const { bulleted = false } = Astro.props;
---

<ul class:list={["contact-links", { "contact-links--bulleted": bulleted }]}>
	<li><a href="https://github.com/JonathanJ4">GitHub</a></li>
	<li><a href="https://www.linkedin.com/in/jonathan-thomas-varughese/">LinkedIn</a></li>
	<li><a href="/resume.pdf">Resume</a></li>
	<li><a href="mailto:jonathanthomasv6@gmail.com">Email</a></li>
</ul>

<style>
	.contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.contact-links--bulleted {
		display: block;
		margin-top: var(--space-3);
		padding-left: var(--space-4);
		list-style: disc;
	}

	.contact-links--bulleted li + li {
		margin-top: var(--space-2);
	}

	.contact-links--bulleted li::marker {
		color: var(--color-muted);
	}

	a {
		text-decoration: none;
	}

	a:hover,
	a:focus-visible {
		text-decoration: underline;
		text-underline-offset: var(--space-1);
	}
</style>
