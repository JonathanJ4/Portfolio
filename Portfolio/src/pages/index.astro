---
import BaseLayout from "../layout/BaseLayout.astro";
import ProjectRow from "../components/ProjectRow.astro";
---

<BaseLayout title="Jonathan Thomas">
	<header class="home-intro">
		<h1>Jonathan Thomas</h1>
		<p class="home-intro__story">
			I'm a third-year Computer Science student at Toronto Metropolitan University and an aspiring software engineer who enjoys exploring different corners of technology,from AI and software systems to embedded computing and robotics.
		</p>
		<p class="home-intro__story">
			Away from the screen, you'll usually find me trying a new recipe or getting lost in a story-driven game.
		</p>
	</header>

	<section class="home-section" aria-labelledby="experience-heading">
		<h2 id="experience-heading">Experience</h2>

		<div class="experience-row">
			<div>
				<h3>Ontario Public Service</h3>
				<p>Software Engineering Intern</p>
			</div>
			<time datetime="2026">2026</time>
		</div>
	</section>

	<section class="home-section" aria-labelledby="projects-heading">
		<h2 id="projects-heading">Recent Projects</h2>

		<ul class="project-list">
			<ProjectRow
				title="Recipe Hub"
				year={2026}
				href="/projects"
			/>
			<ProjectRow
				title="Rust KV Server"
				year={2026}
				href="/projects"
			/>
		</ul>

		<a class="section-link" href="/projects">all projects →</a>
	</section>



	<section class="home-section" aria-label="Elsewhere">
		<ul class="elsewhere-links">
			<li><a href="https://github.com/JonathanJ4">GitHub</a></li>
			<li><a href="https://www.linkedin.com/in/jonathan-thomas-varughese/">LinkedIn</a></li>
			<li><a href="/resume.pdf">Resume</a></li>
			<li><a href="mailto:jonathanthomasv6@gmail.com">Email</a></li>
		</ul>
	</section>
</BaseLayout>
