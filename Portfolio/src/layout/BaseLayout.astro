---
import "../styles/global.css";
import PullCord from "../components/PullCord.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			(() => {
				const root = document.documentElement;
				let theme;

				try {
					theme = window.localStorage.getItem("portfolio-theme");
				} catch {
					theme = null;
				}

				if (theme !== "light" && theme !== "dark") {
					theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
				}

				root.dataset.theme = theme;
				root.style.colorScheme = theme;
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300..600&family=Lora:ital,wght@1,400..700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<div class="site-shell">
			<header class="site-navigation">

				

				<nav aria-label="Primary navigation">
                    <a href="/" aria-current={currentPath === "/" ? "page" : undefined}>
						Home
					</a>
					<a href="/projects" aria-current={currentPath === "/projects" ? "page" : undefined}>
						Projects
					</a>
					<a href="/hobbies" aria-current={currentPath === "/hobbies" ? "page" : undefined}>
						Hobbies
					</a>
					<a href="/contact" aria-current={currentPath === "/contact" ? "page" : undefined}>
						Contact
					</a>
				</nav>
			</header>

			<main class="site-content">
				<slot />
			</main>

			<aside class="site-interaction" aria-label="Theme control">
				<PullCord />
			</aside>
		</div>
	</body>
</html>
