---
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="site-shell">
			<header class="site-navigation">

				

				<nav aria-label="Primary navigation">
                    <a href="/" aria-current={currentPath === "/" ? "page" : undefined}>
						home
					</a>
					<a href="/projects" aria-current={currentPath === "/projects" ? "page" : undefined}>
						projects
					</a>
					<a href="/hobbies" aria-current={currentPath === "/hobbies" ? "page" : undefined}>
						hobbies
					</a>
					<a href="/contact" aria-current={currentPath === "/contact" ? "page" : undefined}>
						contact
					</a>
				</nav>
			</header>

			<main class="site-content">
				<slot />
			</main>

			<div class="site-interaction" aria-hidden="true"></div>
		</div>
	</body>
</html>
